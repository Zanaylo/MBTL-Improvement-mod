#include <windows.h>

#include "../src/Core/info.h"

1 ICON "MBTLIMUpdater.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MBTL_IM_VERSION_MAJOR, MBTL_IM_VERSION_MINOR, MBTL_IM_VERSION_PATCH, 0
PRODUCTVERSION MBTL_IM_VERSION_MAJOR, MBTL_IM_VERSION_MINOR, MBTL_IM_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zanaylo"
            VALUE "FileDescription", MBTL_IM_NAME " Updater"
            VALUE "FileVersion", MBTL_IM_VERSION
            VALUE "InternalName", "MBTLIMUpdater"
            VALUE "OriginalFilename", "MBTLIMUpdater.exe"
            VALUE "ProductName", MBTL_IM_NAME
            VALUE "ProductVersion", MBTL_IM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
